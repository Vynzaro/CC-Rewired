{
    "schemaVersion": 1,
    "id": "computercraft",
    "name": "CC: Rewired",
    "version": "${version}",
    "description": "A modern reengineering of ComputerCraft for current Minecraft, built from CC: Tweaked while preserving ecosystem compatibility.",
    "license": "ComputerCraft Public License 1.0 and other file-level licenses",
    "icon": "pack.png",
    "contact": {
        "homepage": "https://modrinth.com/project/cc-rewired",
        "issues": "https://github.com/Vynzaro/CC-Rewired/issues",
        "sources": "https://github.com/Vynzaro/CC-Rewired"
    },
    "authors": [
        "Vynzaro"
    ],
    "contributors": [
        "CC: Rewired contributors"
    ],
    "environment": "*",
    "entrypoints": {
        "main": [
            "dan200.computercraft.shared.ComputerCraft::init"
        ],
        "client": [
            "dan200.computercraft.client.ComputerCraftClient::init"
        ],
        "jei_mod_plugin": [
            "dan200.computercraft.client.integration.jei.JEIComputerCraft"
        ],
        "rei_client": [
            "dan200.computercraft.client.integration.rei.REIComputerCraft"
        ],
        "emi": [
            "dan200.computercraft.client.integration.emi.EMIComputerCraft"
        ]
    },
    "mixins": [
        "computercraft.fabric.mixins.json",
        {
            "config": "computercraft-client.fabric.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.14.21",
        "fabric-api": ">=0.86.1",
        "minecraft": "=1.20.1"
    },
    "accessWidener": "computercraft.accesswidener"
}
